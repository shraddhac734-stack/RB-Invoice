              "host": ["localhost"],
              "port": "3009",
              "path": ["api", "invoices", "1"]
            }
          }
        },
        {
          "name": "Create Invoice Record",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"Supplier_Invoice_Test.pdf\",\n  \"fileUrl\": \"/uploads/invoices/Supplier_Invoice_Test.pdf\",\n  \"invoiceJson\": \"{\\\"vendor\\\":\\\"Acme Corp\\\",\\\"amount\\\":15000}\",\n  \"isVerified\": \"0\",\n  \"storeId\": 101,\n  \"expenseId\": 201,\n  \"overInvoice\": \"false\",\n  \"totalInvoice\": 1,\n  \"folderPath\": \"uploads/invoices\",\n  \"skipInvoices\": \"false\",\n  \"IsAiIssue\": \"false\",\n  \"isQueue\": \"false\"\n}"
