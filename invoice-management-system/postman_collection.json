              "protocol": "http",
              "host": ["localhost"],
              "port": "3009",
              "path": ["api", "invoices", "counts"]
            }
          }
        },
        {
          "name": "Get All Invoices (with Search & Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3009/api/invoices?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3009",
              "path": ["api", "invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "isVerified", "value": "1", "disabled": true },
                { "key": "isQueue", "value": "true", "disabled": true },
                { "key": "search", "value": "Acme", "disabled": true }
              ]
            }
          }
        },
